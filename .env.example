# Copy to .env and fill in. Never commit the real file.

# --- Toss Securities Open API credentials ---
# Issue these in the Toss Securities WTS under 설정 > Open API,
# and register the NAS's public IP under 허용 IP 관리.
TOSSINVEST_CLIENT_ID=c_replace_me
TOSSINVEST_CLIENT_SECRET=replace_me

# Optional: default account for account-scoped tools.
# Omit when the credentials hold exactly one account — it resolves automatically.
#TOSSINVEST_ACCOUNT_SEQ=1

# --- MCP endpoint authentication (required for TRANSPORT=http) ---
# Generate with: openssl rand -hex 32
# Clients must send: Authorization: Bearer <this value>
MCP_AUTH_TOKEN=replace_me_with_32_random_bytes

# --- Nginx Proxy Manager (only for docker-compose.npm.yml) ---
# The docker network NPM already runs on, so it can reach this container by name.
# Find it with:
#   docker inspect <npm-container> -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
#NPM_NETWORK=npm_default

# --- Cloudflare Tunnel (only for docker-compose.cloudflared.yml) ---
# Zero Trust > Networks > Tunnels > Create a tunnel, then paste the token here.
#TUNNEL_TOKEN=replace_me

# --- Safety ---
# "true" omits every order-placing tool. Recommended for a network-reachable
# deployment.
#
# NOTE for Docker: docker-compose.yml pins TOSSINVEST_READ_ONLY in its
# `environment:` block, which takes precedence over this file. Setting it here
# has NO effect under compose — edit docker-compose.yml instead.
# This variable does work here for non-Docker runs.
TOSSINVEST_READ_ONLY=true
